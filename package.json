{
  "name": "vscode-sybil",
  "displayName": "Sybil",
  "description": "Companion extension for SybilKB — task board, module browser, DCP recall, and quality-gate views for any SybilKB-backed project. Does not edit code; pairs with Claude Code (or any MCP-capable coding agent) for that.",
  "version": "0.0.1",
  "publisher": "sybil-project",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/janostisza89-byte/vscode-sybil.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Other"],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sybil",
          "title": "Sybil",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "sybil": [
        {
          "id": "sybil.setup",
          "name": "Setup",
          "type": "webview"
        },
        {
          "id": "sybil.taskBoard",
          "name": "Task Board",
          "type": "webview"
        },
        {
          "id": "sybil.moduleBrowser",
          "name": "Module Browser",
          "type": "webview"
        },
        {
          "id": "sybil.dcpRecall",
          "name": "DCP Recall",
          "type": "webview"
        },
        {
          "id": "sybil.qualityGate",
          "name": "Quality Gate",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "sybil.setToken",
        "title": "Sybil: Set SybilKB Access Token"
      },
      {
        "command": "sybil.setEndpoint",
        "title": "Sybil: Set SybilKB Endpoint URL"
      },
      {
        "command": "sybil.selectProject",
        "title": "Sybil: Select Project"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  }
}
