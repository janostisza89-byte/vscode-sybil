{
  "name": "vscode-sybil",
  "displayName": "Sybil",
  "description": "Companion extension for SybilKB — task board, module browser, DCP recall, and quality-gate views for any SybilKB-backed project. Does not edit code; pairs with Claude Code (or any MCP-capable coding agent) for that.",
  "version": "0.0.18",
  "publisher": "sybil-project",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/janostisza89-byte/vscode-sybil.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sybil",
          "title": "Sybil",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "sybil": [
        {
          "id": "sybil.setup",
          "name": "Setup",
          "type": "webview"
        },
        {
          "id": "sybil.taskBoard",
          "name": "Task Board",
          "type": "webview",
          "visibility": "collapsed"
        },
        {
          "id": "sybil.docsSearch",
          "name": "Docs Search",
          "type": "webview",
          "visibility": "collapsed"
        },
        {
          "id": "sybil.dcpRecall",
          "name": "DCP Recall",
          "type": "webview",
          "visibility": "collapsed"
        },
        {
          "id": "sybil.qualityGate",
          "name": "Quality Gate",
          "type": "webview",
          "visibility": "collapsed"
        }
      ]
    },
    "commands": [
      {
        "command": "sybil.setToken",
        "title": "Sybil: Set SybilKB Access Token"
      },
      {
        "command": "sybil.setEndpoint",
        "title": "Sybil: Set SybilKB Endpoint URL"
      },
      {
        "command": "sybil.setOwnerId",
        "title": "Sybil: Set User ID"
      },
      {
        "command": "sybil.setProjectId",
        "title": "Sybil: Set Project ID"
      },
      {
        "command": "sybil.addPlaywrightMcp",
        "title": "Sybil: Add Playwright MCP (browser automation)"
      },
      {
        "command": "sybil.cartographerPushCurrentFile",
        "title": "Sybil: Cartographer — Push Current File (one-shot, Python only)"
      }
    ]
  },
  "scripts": {
    "typecheck": "tsc -p ./ --noEmit",
    "bundle": "node esbuild.js",
    "compile": "npm run typecheck && npm run bundle",
    "watch": "node esbuild.js --watch",
    "vscode:prepublish": "npm run compile",
    "package": "npm run compile && vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.22.6"
  }
}
